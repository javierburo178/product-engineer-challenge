PORT=3001

# Database (separate DB in the same Postgres container – Rails-style *_test DB)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=challengedb_test

# Redis (dedicated logical DB for tests; only takes effect once the cache
# store stops hard-coding db 0 – see app.module.ts)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=15
